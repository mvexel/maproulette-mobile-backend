{
  "version": 1,
  "challenge": {
    "name": "Woodbine entrance doors",
    "description": "Help map the doors around Woodbine Food Hall. At each entrance, check how the door opens and whether it opens by itself, so people with wheelchairs, strollers or walkers know what to expect.",
    "instruction": "Survey the door at the mapped entrance node. Sets door=* and automatic_door=* only when missing. No geometry changes.",
    "checkinComment": "Street Tally: entrance doors near Woodbine Food Hall #StreetTallyWoodbine https://wiki.openstreetmap.org/wiki/Organised_Editing/Activities/Street_Tally_Woodbine_Entrances",
    "checkinSource": "survey"
  },
  "match": {},
  "matchKeys": [
    "entrance"
  ],
  "questions": [
    {
      "id": "door-type",
      "prompt": "How does this door open?",
      "description": "Look only at the door at this entrance.",
      "expect": {
        "door": null
      },
      "options": [
        {
          "id": "hinged",
          "label": "Swings open",
          "setTags": {
            "door": "hinged"
          }
        },
        {
          "id": "sliding",
          "label": "Slides sideways",
          "setTags": {
            "door": "sliding"
          }
        },
        {
          "id": "revolving",
          "label": "Revolves",
          "setTags": {
            "door": "revolving"
          }
        },
        {
          "id": "folding",
          "label": "Folds",
          "setTags": {
            "door": "folding"
          }
        }
      ]
    },
    {
      "id": "automatic-opening",
      "prompt": "Does it open by itself?",
      "description": "A door that's propped open doesn't count.",
      "expect": {
        "automatic_door": null
      },
      "options": [
        {
          "id": "no",
          "label": "No, you push or pull it",
          "setTags": {
            "automatic_door": "no"
          }
        },
        {
          "id": "button",
          "label": "Yes, with a button",
          "setTags": {
            "automatic_door": "button"
          }
        },
        {
          "id": "motion",
          "label": "Yes, when you walk up",
          "setTags": {
            "automatic_door": "motion"
          }
        },
        {
          "id": "yes",
          "label": "Yes, not sure how",
          "setTags": {
            "automatic_door": "yes"
          }
        }
      ]
    }
  ],
  "outcomes": [
    {
      "id": "no-door",
      "label": "There's no door",
      "description": "It's an open doorway or a gate.",
      "status": 6
    }
  ],
