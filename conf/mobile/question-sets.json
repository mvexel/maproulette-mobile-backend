{
 "comment": "Street Tally question sets (D-wizard). Bump a set's version whenever its filter, questions or outcomes change. Words are Iris's (design/campaign-wizard.md §1).",
 "sets": [
  {
   "id": "entrance-doors",
   "version": 1,
   "name": "Entrance doors",
   "why": "Wheelchair, stroller and walker users know what to expect",
   "audience": "wheelchair, stroller and walker users",
   "noun": {
    "one": "entrance",
    "many": "entrances"
   },
   "example": "How does this door open?",
   "pace": 30,
   "description": "Help map the {nounMany} around {place}, so {audience} know what to expect.",
   "instruction": "Survey the door at the mapped entrance. Sets door and automatic_door only when missing. No geometry changes.",
   "filter": {
    "elements": [
     "node"
    ],
    "tags": {
     "entrance": null
    },
    "exclude": {
     "entrance": [
      "emergency"
     ],
     "access": [
      "private",
      "no"
     ]
    }
   },
   "match": {},
   "matchKeys": [
    "entrance"
   ],
   "questions": [
    {
     "id": "door-type",
     "prompt": "How does this door open?",
     "description": "Look only at the door at this entrance.",
     "expect": {
      "door": null
     },
     "options": [
      {
       "id": "hinged",
       "label": "Swings open",
       "setTags": {
        "door": "hinged"
       }
      },
      {
       "id": "sliding",
       "label": "Slides sideways",
       "setTags": {
        "door": "sliding"
       }
      },
      {
       "id": "revolving",
       "label": "Revolves",
       "setTags": {
        "door": "revolving"
       }
      },
      {
       "id": "folding",
       "label": "Folds",
       "setTags": {
        "door": "folding"
       }
      }
     ]
    },
    {
     "id": "automatic-opening",
     "prompt": "Does it open by itself?",
     "description": "A door that's propped open doesn't count.",
     "expect": {
      "automatic_door": null
     },
     "options": [
      {
       "id": "no",
       "label": "No, you push or pull it",
       "setTags": {
        "automatic_door": "no"
       }
      },
      {
       "id": "button",
       "label": "Yes, with a button",
       "setTags": {
        "automatic_door": "button"
       }
      },
      {
       "id": "motion",
       "label": "Yes, when you walk up",
       "setTags": {
        "automatic_door": "motion"
       }
      },
      {
       "id": "yes",
       "label": "Yes, not sure how",
       "setTags": {
        "automatic_door": "yes"
       }
      }
     ]
    }
   ],
   "outcomes": [
    {
     "id": "no-door",
     "label": "There's no door",
     "description": "It's an open doorway or a gate.",
     "status": 6
    }
   ]
  },
  {
   "id": "crossings",
   "version": 1,
   "name": "Crossings",
   "why": "Blind and low-vision people find safe crossings",
   "audience": "blind and low-vision people",
   "noun": {
    "one": "crossing",
    "many": "crossings"
   },
   "example": "Are there bumpy warning tiles at the curb?",
   "pace": 25,
   "description": "Help map the {nounMany} around {place}, so {audience} can find safe ones.",
   "instruction": "Survey the crossing at the mapped point. Sets tactile_paving and crossing:markings only when missing. No geometry changes.",
   "filter": {
    "elements": [
     "node"
    ],
    "tags": {
     "highway": "crossing"
    },
    "exclude": {
     "crossing": [
      "no"
     ],
     "access": [
      "private",
      "no"
     ]
    }
   },
   "match": {
    "highway": "crossing"
   },
   "questions": [
    {
     "id": "tactile-paving",
     "prompt": "Are there bumpy warning tiles at the curb?",
     "description": "The raised dots, usually yellow or red, at both ends of the crossing. Pick Yes only if both ends have them.",
     "expect": {
      "tactile_paving": null
     },
     "options": [
      {
       "id": "yes",
       "label": "Yes, both ends",
       "setTags": {
        "tactile_paving": "yes"
       }
      },
      {
       "id": "partial",
       "label": "Only one end",
       "setTags": {
        "tactile_paving": "partial"
       }
      },
      {
       "id": "no",
       "label": "No",
       "setTags": {
        "tactile_paving": "no"
       }
      }
     ]
    },
    {
     "id": "crossing-markings",
     "prompt": "How is the crossing painted?",
     "description": "Look at the road surface where people cross.",
     "expect": {
      "crossing:markings": null
     },
     "options": [
      {
       "id": "zebra",
       "label": "Wide stripes across",
       "setTags": {
        "crossing:markings": "zebra"
       }
      },
      {
       "id": "lines",
       "label": "Two lines along the edges",
       "setTags": {
        "crossing:markings": "lines"
       }
      },
      {
       "id": "ladder",
       "label": "Stripes and edge lines",
       "setTags": {
        "crossing:markings": "ladder"
       }
      },
      {
       "id": "no",
       "label": "No paint",
       "setTags": {
        "crossing:markings": "no"
       }
      }
     ]
    }
   ],
   "outcomes": [
    {
     "id": "no-crossing",
     "label": "There's no crossing here",
     "description": "Nobody can cross the street at this spot.",
     "status": 6
    }
   ]
  },
