# Routes
# This file defines all application routes (Higher priority routes first)
# ~~~~
GET     /ping                                                           @controllers.Application.ping
GET     /oauth/mobile/authorize                                         @controllers.MobileOAuthController.authorize
GET     /oauth/mobile/callback                                          @controllers.MobileOAuthController.callback
POST    /oauth/mobile/consent                                           @controllers.MobileOAuthController.consent
POST    /oauth/mobile/token                                             @controllers.MobileOAuthController.token
POST    /oauth/mobile/revoke                                            @controllers.MobileOAuthController.revoke
GET     /oauth/mobile/me                                                @controllers.MobileOAuthController.me
# Deferred sign-up guests (fork): 404 unless mobileOAuth.guests.enabled, see docs/mobile-oauth.md "Guests"
POST    /oauth/mobile/guest                                             @controllers.MobileGuestController.register
GET     /api/v2/mobile-guest/me                                         @controllers.MobileGuestController.me
DELETE  /api/v2/mobile-guest                                            @controllers.MobileGuestController.delete
PUT     /api/v2/mobile-guest/email                                      @controllers.MobileGuestEmailController.setEmail
PUT     /api/v2/mobile-guest/reminders                                  @controllers.MobileGuestTokenController.reminders
POST    /api/v2/mobile-claim                                            @controllers.MobileClaimController.claim
GET     /api/v2/mobile-claim/:id                                        @controllers.MobileClaimController.status(id:Long)
POST    /api/v2/mobile-claim/:id/retry                                  @controllers.MobileClaimController.retry(id:Long)
POST    /api/v2/mobile-claim/preview                                    @controllers.MobileGuestTokenController.preview
POST    /api/v2/mobile-claim/delete                                     @controllers.MobileGuestTokenController.delete
POST    /api/v2/mobile-claim/stop-reminders                             @controllers.MobileGuestTokenController.stopReminders
GET     /api/v2/mobile-guest/pending                                    @org.maproulette.controllers.api.MobileChoicePendingController.list
POST    /api/v2/task/:id/choice/pending                                 @org.maproulette.controllers.api.MobileChoicePendingController.submit(id:Long)
DELETE  /api/v2/task/:id/choice/pending                                 @org.maproulette.controllers.api.MobileChoicePendingController.withdraw(id:Long)
# Mobile admin API (fork): mobile:admin bearer grants of super-users, and mobile:organize grants
# of organizers for the campaign routes (D8), see docs/mobile-admin-api.md
GET     /api/v2/mobile-admin/clients                                    @controllers.MobileAdminController.listClients
GET     /api/v2/mobile-admin/scope-sets                                 @controllers.MobileAdminController.scopeSets
POST    /api/v2/mobile-admin/clients                                    @controllers.MobileAdminController.createClient
PATCH   /api/v2/mobile-admin/clients/:id                                @controllers.MobileAdminController.updateClient(id:String, revokeGrants:Boolean ?= false)
GET     /api/v2/mobile-admin/audit                                      @controllers.MobileAdminController.audit(limit:Int ?= 50, page:Int ?= 0)
GET     /api/v2/mobile-admin/write-policy                               @controllers.MobileAdminController.getWritePolicy
PUT     /api/v2/mobile-admin/write-policy                               @controllers.MobileAdminController.setWritePolicy
GET     /api/v2/mobile-admin/challenges/:id/results                     @controllers.MobileResultsController.results(id:Long, format:String ?= "csv")
GET     /api/v2/mobile-admin/challenges/:id/live                        @controllers.MobileLiveController.get(id:Long)
PUT     /api/v2/mobile-admin/challenges/:id/live                        @controllers.MobileLiveController.update(id:Long)
POST    /api/v2/mobile-admin/challenges/:id/live/rotate                 @controllers.MobileLiveController.rotate(id:Long)
POST    /api/v2/mobile-admin/challenges/:id/queue                       @controllers.MobileQueueController.generate(id:Long)
GET     /api/v2/mobile-admin/challenges/:id/queue/export                @controllers.MobileQueueController.exportQueue(id:Long)
GET     /api/v2/mobile-admin/campaigns                                  @controllers.MobileCampaignController.listCampaigns
GET     /api/v2/mobile-admin/projects                                   @controllers.MobileCampaignController.listProjects
POST    /api/v2/mobile-admin/projects                                   @controllers.MobileCampaignController.createProject
PUT     /api/v2/mobile-admin/projects/:id/enabled                       @controllers.MobileCampaignController.setProjectEnabled(id:Long)
GET     /api/v2/mobile-admin/organizers                                 @controllers.MobileOrganizerController.list
POST    /api/v2/mobile-admin/organizers                                 @controllers.MobileOrganizerController.add
DELETE  /api/v2/mobile-admin/organizers/:userId                         @controllers.MobileOrganizerController.remove(userId:Long)
DELETE  /api/v2/mobile-admin/organizers/:userId/projects/:projectId     @controllers.MobileOrganizerController.removeProject(userId:Long, projectId:Long)
# Organizer requests (ORG-ONB): the requester's own, by their mobile:organizer-request grant, and the super-user decisions
GET     /api/v2/mobile-admin/organizer-request                          @controllers.MobileOrganizerRequestController.status
POST    /api/v2/mobile-admin/organizer-request                          @controllers.MobileOrganizerRequestController.create
GET     /api/v2/mobile-admin/organizer-requests                         @controllers.MobileOrganizerRequestController.list
POST    /api/v2/mobile-admin/organizer-requests/:id/approve             @controllers.MobileOrganizerRequestController.approve(id:Long)
POST    /api/v2/mobile-admin/organizer-requests/:id/decline             @controllers.MobileOrganizerRequestController.decline(id:Long)
# Campaign wizard (fork): question sets, counts and open features from Overpass, create and publish
GET     /api/v2/mobile-admin/wizard/question-sets                       @controllers.MobileWizardController.questionSets
GET     /api/v2/mobile-admin/wizard/question-sets/:id/features          @controllers.MobileWizardController.features(id:String)
GET     /api/v2/mobile-admin/wizard/counts                              @controllers.MobileWizardController.counts
GET     /api/v2/mobile-admin/wizard/coverage                            @controllers.MobileWizardController.coverage
POST    /api/v2/mobile-admin/wizard/campaigns                           @controllers.MobileWizardController.create
POST    /api/v2/mobile-admin/wizard/campaigns/:id/publish               @controllers.MobileWizardController.publish(id:Long)
# Live progress page (fork, BACKLOG #12): public and link-only, by an unguessable token
GET     /api/v2/live/:token                                             @controllers.MobileLiveController.show(token:String)
# Review page (fork, H1a): read by the live page token; marks need an app grant (docs/mobile-admin-api.md)
GET     /api/v2/review/:token                                           @controllers.MobileReviewController.show(token:String)
PUT     /api/v2/review/:token/places/:id/skip                           @controllers.MobileReviewController.skip(token:String, id:Long)
DELETE  /api/v2/review/:token/places/:id/skip                           @controllers.MobileReviewController.skip(token:String, id:Long)
PUT     /api/v2/review/:token/places/:id/needs-visit                    @controllers.MobileReviewController.needsVisit(token:String, id:Long)
DELETE  /api/v2/review/:token/places/:id/needs-visit                    @controllers.MobileReviewController.needsVisit(token:String, id:Long)
# Authentication Routes
GET     /auth/authenticate                                              @controllers.AuthController.authenticate(redirectUri: String ?= "")
GET     /auth/callback                                                  @controllers.AuthController.callback(code: String, state: String)
GET     /auth/signout                                                   @controllers.AuthController.signOut
POST    /auth/signIn                                                    @controllers.AuthController.signIn(redirect:String ?= "")
GET     /auth/generateAPIKey                                            @controllers.AuthController.generateAPIKey(userId:Long ?= -1)
POST    /auth/resetAllAPIKeys                                           @controllers.AuthController.resetAllAPIKeys
DELETE  /auth/deleteUser/userId                                         @controllers.AuthController.deleteUser(userId:Long)
GET     /auth/addUser/:userId/toProject/:projectId                      @controllers.AuthController.addUserToProject(userId:Long, projectId:Long)
# Random functionality routes
GET     /clearCaches                                                    @controllers.Application.clearCaches
PUT     /runJob/:name                                                   @controllers.Application.runJob(name:String, action:String ?= "")
GET     /ws                                                             @org.maproulette.framework.controller.WebSocketController.socket
# Routes for /docs redirect and serving the swagger-ui
GET     /docs                                                           @controllers.Application.redirectDocs()
GET     /docs/swagger-ui/*file                                          @controllers.Assets.at(path:String="/public/swagger", file:String)
### NoDocs ###
GET     /assets/*file                                                   @controllers.Assets.versioned(path="/public", file: Asset)

->      /api/v2/                                                        generated.Routes

GET     /*path/                                                         @controllers.Application.untrail(path:String)
